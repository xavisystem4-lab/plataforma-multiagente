# Copia generada por `npm run setup` en .env (nunca se sube a Git).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATA_DIR=./data
# Secreto para firmar tokens de acceso (mínimo 32 caracteres aleatorios).
JWT_SECRET=
# Clave maestra de la bóveda: 32 bytes en base64. Cifra claves API y tokens de GitHub.
MASTER_KEY=
# Orígenes permitidos (app Electron, Vite en desarrollo, Capacitor Android).
CORS_ORIGINS=app://ui,http://localhost:5173,https://localhost,capacitor://localhost
# "true" solo detrás de un proxy propio (Caddy) en producción.
TRUST_PROXY=false
