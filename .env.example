# Copia generada por `npm run setup` en .env (nunca se sube a Git).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATA_DIR=./data
# Secreto para firmar tokens de acceso (mínimo 32 caracteres aleatorios).
JWT_SECRET=
# Clave maestra de la bóveda: 32 bytes en base64. Cifra claves API y tokens de GitHub.
MASTER_KEY=
# Orígenes permitidos (app Electron, Vite en desarrollo, Capacitor Android).
CORS_ORIGINS=app://ui,http://localhost:5173,https://localhost,capacitor://localhost
# "true" solo detrás de un proxy propio (Caddy) en producción.
TRUST_PROXY=false
# API de GitHub (GitHub Enterprise Server: https://<host>/api/v3)
GITHUB_API_URL=https://api.github.com
# Límites por usuario
MAX_AGENTES_POR_USUARIO=50
MAX_PROYECTOS_POR_USUARIO=100
# Ejecución de tareas
MAX_TAREAS_SIMULTANEAS=4
MAX_TURNOS_POR_EJECUCION=60
# Sandbox Docker para las validaciones (sin Docker se reportan como "no ejecutadas")
SANDBOX_IMAGEN=node:22-bookworm-slim
SANDBOX_CPUS=2
SANDBOX_MEMORIA=2g
SANDBOX_USUARIO=1000:1000
TIMEOUT_VALIDACION_MIN=10
# Respaldos automáticos de la base de datos (0 = desactivados)
RESPALDO_CADA_HORAS=24
RESPALDOS_A_CONSERVAR=7
