{
  "name": "@softgala/server",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "esbuild src/server.ts src/cli/crear-usuario.ts src/cli/respaldo.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:@anthropic-ai/sdk --external:@fastify/* --external:fastify --external:jose --external:zod",
    "usuario:crear": "tsx --env-file-if-exists=../../.env src/cli/crear-usuario.ts",
    "respaldo:crear": "tsx --env-file-if-exists=../../.env src/cli/respaldo.ts crear",
    "respaldo:restaurar": "tsx --env-file-if-exists=../../.env src/cli/respaldo.ts restaurar",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@softgala/shared": "*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
